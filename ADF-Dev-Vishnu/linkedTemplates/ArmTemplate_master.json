{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADF-Dev-Vishnu"
		},
		"LS_ADLS_Source_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_Source'"
		},
		"LS_Source_SQL_DB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_Source_SQL_DB'"
		},
		"LS_sql_systemidt_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_sql_systemidt'",
			"defaultValue": "Integrated Security=False;Encrypt=True;Connection Timeout=30;Data Source=sqlserverdevcourse.database.windows.net;Initial Catalog=SQLdbdev"
		},
		"LS_target_DB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_target_DB'"
		},
		"LS_ADLS_Source_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsgen2course.dfs.core.windows.net"
		},
		"LS_AzureKeyVault1_SQL_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://ADF-keyvault-vishnu-dev.vault.azure.net/"
		},
		"LS_SQL_keyvault_properties_typeProperties_connectionString_secretName": {
			"type": "string",
			"defaultValue": "sqlsecret"
		},
		"LS_Source_SQL_DB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserverdevcourse.database.windows.net"
		},
		"LS_Source_SQL_DB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "SQLdbdev"
		},
		"LS_Source_SQL_DB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Vishnu"
		},
		"LS_target_DB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserverdevcourse.database.windows.net"
		},
		"LS_target_DB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "targetsqldbdev"
		},
		"LS_target_DB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Vishnu"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADF-Dev-Vishnu_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_Source_accountKey": {
						"value": "[parameters('LS_ADLS_Source_accountKey')]"
					},
					"LS_Source_SQL_DB_password": {
						"value": "[parameters('LS_Source_SQL_DB_password')]"
					},
					"LS_sql_systemidt_connectionString": {
						"value": "[parameters('LS_sql_systemidt_connectionString')]"
					},
					"LS_target_DB_password": {
						"value": "[parameters('LS_target_DB_password')]"
					},
					"LS_ADLS_Source_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Source_properties_typeProperties_url')]"
					},
					"LS_AzureKeyVault1_SQL_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_AzureKeyVault1_SQL_properties_typeProperties_baseUrl')]"
					},
					"LS_Source_SQL_DB_properties_typeProperties_server": {
						"value": "[parameters('LS_Source_SQL_DB_properties_typeProperties_server')]"
					},
					"LS_Source_SQL_DB_properties_typeProperties_database": {
						"value": "[parameters('LS_Source_SQL_DB_properties_typeProperties_database')]"
					},
					"LS_Source_SQL_DB_properties_typeProperties_userName": {
						"value": "[parameters('LS_Source_SQL_DB_properties_typeProperties_userName')]"
					},
					"LS_target_DB_properties_typeProperties_server": {
						"value": "[parameters('LS_target_DB_properties_typeProperties_server')]"
					},
					"LS_target_DB_properties_typeProperties_database": {
						"value": "[parameters('LS_target_DB_properties_typeProperties_database')]"
					},
					"LS_target_DB_properties_typeProperties_userName": {
						"value": "[parameters('LS_target_DB_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "ADF-Dev-Vishnu_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'ADF-Dev-Vishnu_ArmTemplate_0')]"
			]
		},
		{
			"name": "ADF-Dev-Vishnu_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_SQL_keyvault_properties_typeProperties_connectionString_secretName": {
						"value": "[parameters('LS_SQL_keyvault_properties_typeProperties_connectionString_secretName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'ADF-Dev-Vishnu_ArmTemplate_1')]"
			]
		},
		{
			"name": "ADF-Dev-Vishnu_ArmTemplate_3",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_3.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'ADF-Dev-Vishnu_ArmTemplate_2')]"
			]
		}
	]
}